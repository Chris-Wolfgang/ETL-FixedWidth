# Per-src-project overrides for Wolfgang.Etl.FixedWidth
#
# Solution-wide analyzer rules live in the root .editorconfig. Only add
# entries here when the rule itself is genuinely wrong for THIS whole
# project — not for individual call-sites (use `#pragma warning disable`
# or [SuppressMessage] at the call-site instead).

[*.cs]

# CheckNamespace — this project ships two categories of files whose
# namespace deliberately does NOT match the folder:
#
#   1. Properties/IsExternalInit.cs — polyfill of
#      System.Runtime.CompilerServices.IsExternalInit for TFMs (net462,
#      netstandard2.0) that lack the runtime type. The namespace is
#      required by the C# 9 init-only setter feature and cannot be
#      renamed.
#
#   2. Pipeline/*.cs (IFixedWidthExtractorBuilder, FixedWidthLoaderBuilder,
#      EtlPipelineFixedWidthExtensions, etc.) — by design in the top-level
#      Wolfgang.Etl.FixedWidth namespace so consumers pick them up with a
#      single `using` directive alongside the extractors/loaders. Moving
#      them to Wolfgang.Etl.FixedWidth.Pipeline would be a breaking
#      public-API change.
#
# R# .DotSettings has no file-scoped severity override, so the rule is
# silenced project-wide here rather than per-file. Everything else stays
# active; per-call-site false positives get an inline `#pragma` or
# [SuppressMessage] with the reason.
resharper_check_namespace_highlighting = none

# S1133 ("remove this deprecated code someday") — every [Obsolete] member in this
# project is a deliberate deprecation marker for the dated removal wave (#373,
# not before 2026-12-15). The rule is wrong for the whole project until then.
dotnet_diagnostic.S1133.severity = none

# S3427 ("signature overlaps … default parameter value can't be used") — the
# `= null` defaults on the (source, logger) / (source, options, logger)
# constructors of these three files are redundant next to their sibling
# overloads, but removing them rewrites recorded public signatures. The next
# release ships with none, so they stay until the 2026-12-15 removal wave
# (#495); delete these entries with them.
[FixedWidthExtractor.cs]
dotnet_diagnostic.S3427.severity = none

[FixedWidthLoader.cs]
dotnet_diagnostic.S3427.severity = none

[FixedWidthTransformer.cs]
dotnet_diagnostic.S3427.severity = none
