<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Roslyn source generators / analyzers MUST target netstandard2.0 — it is the
         analyzer host load contract. This project is NOT multi-targeted. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>

    <!-- This project is not packed on its own — its DLL is embedded into the main
         Wolfgang.Etl.FixedWidth NuGet under analyzers/dotnet/cs (see the main csproj
         PackAnalyzer target). It has no public API surface and ships no docs. -->
    <IsPackable>false</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- Analyzer-project noise that does not apply here:
         RS1036 - the SDK analyzer-release-tracking prompt (satisfied by AnalyzerReleases.*.txt below)
         MA0028 - interpolated StringBuilder.AppendLine (the generator IS an emitter; readability wins)
         NU1701 - transitive package TFM fallback for the Roslyn packages
         (RS2008 is NOT suppressed — the diagnostic IDs are tracked in AnalyzerReleases.*.txt.) -->
    <NoWarn>$(NoWarn);RS1036;MA0028;NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- Analyzer release tracking (RS2007/RS2008): the shipped/unshipped diagnostic IDs. -->
  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.txt" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.txt" />
  </ItemGroup>

</Project>
